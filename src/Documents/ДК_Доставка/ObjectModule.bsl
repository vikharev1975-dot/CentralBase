Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		// Заполнение шапки
		Договор = ДанныеЗаполнения.Договор;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		Ответственный = ДанныеЗаполнения.Ответственный;
		Основание = ДанныеЗаполнения.Ссылка;
		Для Каждого ТекСтрокаТовары Из ДанныеЗаполнения.Товары Цикл
			НоваяСтрока = Товары.Добавить();
			НоваяСтрока.Количество = ТекСтрокаТовары.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТовары.Номенклатура;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
// -- Вихарев А.А. 22.08.2026

// ++ Вихарев А.А. 9 ноября 2026 г.
Процедура ПриЗаписи(Отказ)
	
	// Если идет загрузка данных из обмена ничего не регистрируем
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Ответственный) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ДК_ОбменСМобильнымиУстройством.Ссылка КАК Ссылка
			|ИЗ
			|	ПланОбмена.ДК_ОбменСМобильнымиУстройством КАК ДК_ОбменСМобильнымиУстройством
			|ГДЕ
			|	ДК_ОбменСМобильнымиУстройством.Пользователь = &Пользователь
			|	И НЕ ДК_ОбменСМобильнымиУстройством.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Пользователь", Ответственный);
		
		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл
		// Регистрируем ответственного на узле плана обмена
			ОбменДанными.Получатели.Добавить(Выборка.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// -- Вихарев А.А. 9 ноября 2026 г.
