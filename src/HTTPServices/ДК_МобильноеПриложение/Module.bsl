КонецФункции

Функция ПолучитьЗаказыGet(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ТекущийИсполнитель = Пользователи.ТекущийПользователь(); 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказПокупателя.Ссылка) КАК Количество
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Ответственный = &Ответственный
	|	И НЕ ЗаказПокупателя.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ответственный", ТекущийИсполнитель);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоЗаказов = 0;
	
	Если Выборка.Следующий() Тогда
		КоличествоЗаказов = Выборка.Количество;
	КонецЕсли;
	
	// Формируем JSON-ответ
	ДанныеДляОтправки = Новый Структура;
	// СтруктураОтвета.Вставить("success", Истина);
	// СтруктураОтвета.Вставить("orders_count", КоличествоЗаказов);
	ДанныеДляОтправки.Вставить("КоличествоЗаказов", КоличествоЗаказов);
	
	//ТелоОтвета = ЗаписатьЗначениеJSON(ДанныеДляОтправки);
	//Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ДанныеДляОтправки);
	СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
	
КонецФункции

Функция АвторизацияPost(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	// Раз код дошел до этой строчки, логин и пароль успешно прошли проверку!
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	// Формируем простой JSON-ответ с ФИО курьера
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("Успех", Истина);
	СтруктураОтвета.Вставить("ИмяПользователя", ТекущийПользователь.ПолноеИмя);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8);
	
	Возврат Ответ;
	
КонецФункции

Функция АутентификацияGet(Запрос)
	
	//Ответ = Новый HTTPСервисОтвет(200);
	//Возврат Ответ;

	// Раз управление дошло сюда, платформа 1С уже проверила логин и пароль из заголовка Authorization.
	// Нам остается только вернуть успешный статус 200 OK и базовую информацию о сессии.
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	РезультатАвторизации = Новый Структура;
	РезультатАвторизации.Вставить("authenticated", Истина);
	РезультатАвторизации.Вставить("user_name", ТекущийПользователь.Имя);
	РезультатАвторизации.Вставить("full_name", ТекущийПользователь.ПолноеИмя);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, РезультатАвторизации);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
	
КонецФункции

