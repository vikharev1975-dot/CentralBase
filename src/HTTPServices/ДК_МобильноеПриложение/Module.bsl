Функция АвторизацияGet(Запрос) 
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИдентификаторУстройства = Запрос.Заголовки.Получить("X-MobileID");
	
	////Фиксируем вход и ID устройства в Журнале регистрации центральной базы
	//ЗаписьЖурналаРегистрации(
	//"МобильныйКлиент.Аутентификация",
	//УровеньЖурналаРегистрации.Информация,
	//,
	//,
	//СтрШаблон("Успешный вход пользователя [%1]. X-MobileID: %2", ТекущийПользователь.Имя, ИдентификаторУстройства)
	//);
	
	//Формируем ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	РезультатАвторизации = Новый Структура;
	РезультатАвторизации.Вставить("СтатусАвторизации", Истина);
	РезультатАвторизации.Вставить("Пользователь", ТекущийПользователь.Имя);
	РезультатАвторизации.Вставить("ПолноеИмяПользователя", ТекущийПользователь.ПолноеИмя);
	РезультатАвторизации.Вставить("ИдентификаторМобильногоУстройства", ИдентификаторУстройства);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, РезультатАвторизации);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

Функция ОбменДоставкаКлиентамGet(Запрос)
	
	МассивДокументов = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДК_Доставка.Ссылка КАК Ссылка,
	|	ДК_Доставка.Номер КАК Номер,
	|	ДК_Доставка.Дата КАК Дата,
	|	ДК_Доставка.АдресДоставки КАК АдресДоставки
	|ИЗ
	|	Документ.ДК_Доставка КАК ДК_Доставка
	|ГДЕ
	|	ДК_Доставка.Проведен = ИСТИНА";

	// При необходимости добавьте отбор по СтатусДоставки или Ответственному
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтруктураДокумента = Новый Структура;
		СтруктураДокумента.Вставить("УникальныйИдентификаторДокумента", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		СтруктураДокумента.Вставить("Номер", Выборка.Номер);
		СтруктураДокумента.Вставить("Дата", Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss"));
		СтруктураДокумента.Вставить("АдресДоставки", Выборка.АдресДоставки);
		
		// Собираем табличную часть Товары
		МассивТоваров = Новый Массив;
		Для Каждого СтрокаТЧ Из Выборка.Ссылка.Товары Цикл
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("УникальныйНомерНоменклатура", Строка(СтрокаТЧ.Номенклатура.УникальныйИдентификатор()));
			СтруктураТовара.Вставить("Наименование", СтрокаТЧ.Номенклатура.Наименование);
			СтруктураТовара.Вставить("Количество", СтрокаТЧ.Количество);
			МассивТоваров.Добавить(СтруктураТовара);
		КонецЦикла;
		
		СтруктураДокумента.Вставить("Товары", МассивТоваров);
		МассивДокументов.Добавить(СтруктураДокумента);
	КонецЦикла;
	
	// Сериализация в JSON
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, МассивДокументов);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	// Формирование ответа
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON);
	
	Возврат Ответ;	
	
	
КонецФункции

