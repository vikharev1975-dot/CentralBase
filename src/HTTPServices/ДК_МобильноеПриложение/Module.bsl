#Область ОбработчикиСобытий

Функция АвторизацияGet(Запрос) 
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИдентификаторУстройства = Запрос.Заголовки.Получить("X-Mobile-ID");
	
	////Фиксируем вход и ID устройства в Журнале регистрации центральной базы
	//ЗаписьЖурналаРегистрации(
	//"МобильныйКлиент.Аутентификация",
	//УровеньЖурналаРегистрации.Информация,
	//,
	//,
	//СтрШаблон("Успешный вход пользователя [%1]. X-MobileID: %2", ТекущийПользователь.Имя, ИдентификаторУстройства)
	//);
	
	//Формируем ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	РезультатАвторизации = Новый Структура;
	РезультатАвторизации.Вставить("СтатусАвторизации", Истина);
	РезультатАвторизации.Вставить("Пользователь", ТекущийПользователь.Имя);
	РезультатАвторизации.Вставить("ПолноеИмяПользователя", ТекущийПользователь.ПолноеИмя);
	РезультатАвторизации.Вставить("ИдентификаторМобильногоУстройства", ИдентификаторУстройства);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, РезультатАвторизации);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции


// ++ Вихарев А.А. 15 ноября 2026 г.
// Обмен с мобильным приложением курьера.
// При первом вызове с устройства создается узел плана обмена "ДК_ОбменСМобильнымУстройством",
// связанный с текущим пользователем, и регистрируются все его документы "Доставка".
// В ответ передаются изменения документов, зарегистрированные для этого узла.

Функция ОбменGet(Запрос)
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИдентификаторУстройства = Запрос.Заголовки.Получить("X-Mobile-ID");
	Если НЕ ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		Возврат ОтветОбмена(400, ДанныеОшибки("Не заполнен заголовок X-Mobile-ID"));
	КонецЕсли;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если НЕ ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат ОтветОбмена(401, ДанныеОшибки("Пользователь не авторизован"));
	КонецЕсли;
	
	Узел = УзелОбмена(ИдентификаторУстройства, ТекущийПользователь);
	
	Возврат ОтветОбмена(200, ДанныеОбмена(Узел));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает узел плана обмена, соответствующий устройству.
// При первом обращении создает узел и выполняет первичную регистрацию документов пользователя.
//
// Параметры:
//  ИдентификаторУстройства - Строка - значение заголовка X-Mobile-ID.
//  ТекущийПользователь - СправочникСсылка.Пользователи - пользователь, от имени которого выполнен вызов.
//
// Возвращаемое значение:
//  ПланОбменаСсылка.ДК_ОбменСМобильнымУстройством - узел обмена устройства.
//
Функция УзелОбмена(ИдентификаторУстройства, ТекущийПользователь)
	
	Узел = ПланыОбмена.ДК_ОбменСМобильнымУстройством.НайтиПоКоду(ИдентификаторУстройства);
	
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		
		УзелОбъект = ПланыОбмена.ДК_ОбменСМобильнымУстройством.СоздатьУзел();
		УзелОбъект.Код = ИдентификаторУстройства;
		УзелОбъект.Наименование = ИдентификаторУстройства;
		УзелОбъект.Пользователь = ТекущийПользователь;
		УзелОбъект.Записать();
		
		Узел = УзелОбъект.Ссылка;
		
		ЗарегистрироватьДокументыПользователя(Узел, ТекущийПользователь);
		
	КонецЕсли;
	
	УстановитьКодЦентральногоУзла();
	
	Возврат Узел;
	
КонецФункции

// Присваивает коду текущего (центрального) узла плана обмена значение "main".
Процедура УстановитьКодЦентральногоУзла()
	
	ЦентральныйУзел = ПланыОбмена.ДК_ОбменСМобильнымУстройством.ЭтотУзел();
	
	Если НЕ ЗначениеЗаполнено(ЦентральныйУзел) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦентральныйУзел.Код) Тогда
		Возврат;
	КонецЕсли;
	
	УзелОбъект = ЦентральныйУзел.ПолучитьОбъект();
	УзелОбъект.Код = "main";
	УзелОбъект.Наименование = "Центральный узел";
	УзелОбъект.Записать();
	
КонецПроцедуры

// Регистрирует узлу все документы "Доставка", ответственным в которых указан пользователь.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ДК_ОбменСМобильнымУстройством - узел, для которого регистрируются изменения.
//  Пользователь - СправочникСсылка.Пользователи - ответственный документов.
//
Процедура ЗарегистрироватьДокументыПользователя(Узел, Пользователь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДК_Доставка.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ДК_Доставка КАК ДК_Доставка
	|ГДЕ
	|	ДК_Доставка.Ответственный = &Ответственный
	|	И НЕ ДК_Доставка.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ответственный", Пользователь);
	
	ДокументыКРегистрации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Если ДокументыКРегистрации.Количество() > 0 Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, ДокументыКРегистрации);
	КонецЕсли;
	
КонецПроцедуры

// Формирует данные для передачи устройству: изменения, зарегистрированные для узла.
//
// Параметры:
//  Узел - ПланОбменаСсылка.ДК_ОбменСМобильнымУстройством - узел, для которого выбираются изменения.
//
// Возвращаемое значение:
//  Структура - ключи: КодУзла, НомерСообщения, Документы (массив структур).
//
Функция ДанныеОбмена(Узел)
	
	НомерСообщения = Узел.НомерОтправленного + 1;
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщения);
	
	ДокументыОбмена = Новый Массив;
	
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Данные = ВыборкаИзменений.Получить();
		
		Если ТипЗнч(Данные) = Тип("УдалениеОбъекта") Тогда
			ДокументыОбмена.Добавить(ДанныеУдаления(Данные));
		Иначе
			ДокументыОбмена.Добавить(ДанныеДокумента(Данные));
		КонецЕсли;
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("КодУзла", Узел.Код);
	Результат.Вставить("НомерСообщения", НомерСообщения);
	Результат.Вставить("Документы", ДокументыОбмена);
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление документа "Доставка" для сериализации в JSON.
//
// Параметры:
//  Документ - ДокументОбъект.ДК_Доставка - документ, изменение которого передается.
//
// Возвращаемое значение:
//  Структура - реквизиты документа и табличная часть "Товары".
//
Функция ДанныеДокумента(Документ)
	
	Данные = Новый Структура;
	Данные.Вставить("Ссылка", XMLСтрока(Документ.Ссылка));
	Данные.Вставить("Номер", Документ.Номер);
	Данные.Вставить("Дата", XMLСтрока(Документ.Дата));
	Данные.Вставить("ПометкаУдаления", Документ.ПометкаУдаления);
	Данные.Вставить("Организация", Строка(Документ.Организация));
	Данные.Вставить("Контрагент", Строка(Документ.Контрагент));
	Данные.Вставить("Договор", Строка(Документ.Договор));
	Данные.Вставить("АдресДоставки", Документ.АдресДоставки);
	Данные.Вставить("Комментарий", Документ.Комментарий);
	Данные.Вставить("Статус", Строка(Документ.Статус));
	Данные.Вставить("Основание", XMLСтрока(Документ.Основание));
	Данные.Вставить("Товары", ДанныеТоваров(Документ));
	
	Возврат Данные;
	
КонецФункции

// Возвращает табличную часть "Товары" документа в виде массива структур.
//
// Параметры:
//  Документ - ДокументОбъект.ДК_Доставка - документ, товары которого передаются.
//
// Возвращаемое значение:
//  Массив из Структура - элементы с ключами Номенклатура и Количество.
//
Функция ДанныеТоваров(Документ)
	
	Товары = Новый Массив;
	
	Для Каждого СтрокаТоваров Из Документ.Товары Цикл
		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("Номенклатура", Строка(СтрокаТоваров.Номенклатура));
		ДанныеСтроки.Вставить("Количество", СтрокаТоваров.Количество);
		Товары.Добавить(ДанныеСтроки);
	КонецЦикла;
	
	Возврат Товары;
	
КонецФункции

// Возвращает описание удаленного объекта для сериализации в JSON.
//
// Параметры:
//  УдаляемыйОбъект - УдалениеОбъекта - данные об удаленном объекте.
//
// Возвращаемое значение:
//  Структура - ключи: Ссылка, Удалён.
//
Функция ДанныеУдаления(УдаляемыйОбъект)
	
	Данные = Новый Структура;
	Данные.Вставить("Ссылка", XMLСтрока(УдаляемыйОбъект.Ссылка));
	Данные.Вставить("Удалён", Истина);
	
	Возврат Данные;
	
КонецФункции

// Формирует структуру с описанием ошибки.
//
// Параметры:
//  ТекстОшибки - Строка - описание ошибки для мобильного приложения.
//
// Возвращаемое значение:
//  Структура - ключ Ошибка.
//
Функция ДанныеОшибки(ТекстОшибки)
	
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", ТекстОшибки);
	
	Возврат Результат;
	
КонецФункции

// Формирует HTTP-ответ с телом в формате JSON.
//
// Параметры:
//  КодСостояния - Число - код состояния HTTP.
//  Данные - Структура - данные, сериализуемые в JSON.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ сервиса.
//
Функция ОтветОбмена(КодСостояния, Данные)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

