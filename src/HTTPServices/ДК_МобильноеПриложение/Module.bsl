Функция АвторизацияGet(Запрос) 
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	ИдентификаторУстройства = Запрос.Заголовки.Получить("X-Mobile-ID");
	
	////Фиксируем вход и ID устройства в Журнале регистрации центральной базы
	//ЗаписьЖурналаРегистрации(
	//"МобильныйКлиент.Аутентификация",
	//УровеньЖурналаРегистрации.Информация,
	//,
	//,
	//СтрШаблон("Успешный вход пользователя [%1]. X-MobileID: %2", ТекущийПользователь.Имя, ИдентификаторУстройства)
	//);
	
	//Формируем ответ
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	
	РезультатАвторизации = Новый Структура;
	РезультатАвторизации.Вставить("СтатусАвторизации", Истина);
	РезультатАвторизации.Вставить("Пользователь", ТекущийПользователь.Имя);
	РезультатАвторизации.Вставить("ПолноеИмяПользователя", ТекущийПользователь.ПолноеИмя);
	РезультатАвторизации.Вставить("ИдентификаторМобильногоУстройства", ИдентификаторУстройства);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, РезультатАвторизации);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

 
