#Область ЗаписатьJSON 

&НаКлиенте
Асинх Процедура СохранитьВФайлJSON(Команда)
	
	Если НЕ ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Выберите документ Заказ покупрателя!";
		СообщениеПользователю.Сообщить();
		Возврат;
	КонецЕсли;
	
	АдресВХранилище = СформироватьФайлНаСервереJSON(ЗаказПокупателя, УникальныйИдентификатор);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Сохранить Заказ покупателя в JSON";
	Диалог.Расширение = "json";
	Диалог.Фильтр = "Файл JSON|*.json";
	Диалог.ПолноеИмяФайла = ОчиститьИмяФайла(ЗаказПокупателя) + ".json";
	
	ВыбранныеФайлы = Ждать Диалог.ВыбратьАсинх();
	
	Если ВыбранныеФайлы = Неопределено Тогда
		УдалитьИзВременногоХранилища(АдресВХранилище);
		Возврат;
	КонецЕсли;
	
	ПолноеИмяФайла = ВыбранныеФайлы[0];
	
	Если НЕ СтрЗаканчиваетсяНа(НРег(ПолноеИмяФайла), ".json") Тогда
		ПолноеИмяФайла = ПолноеИмяФайла + ".json";
	КонецЕсли;
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ДанныеФайла.Записать(ПолноеИмяФайла);
	
	УдалитьИзВременногоХранилища(АдресВХранилище);
	
	СообщениеПользователю = Новый СообщениеПользователю;
	СообщениеПользователю.Текст = СтрШаблон("Файл успешно сохранен: %1.", ПолноеИмяФайла);
	СообщениеПользователю.Сообщить();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьФайлНаСервереJSON(ЗаказПокупателяСсылка, УникальныйИдентификаторФормы)
	
	ЗаказПокупателяОбъект = ЗаказПокупателяСсылка.ПолучитьОбъект();
	
	Если ЗаказПокупателяОбъект = Неопределено Тогда
		ВызватьИсключение "Заказ покупателя не найден.";
	КонецЕсли;
	
	// Формируем структуру с наименованиями вместо UUID
	Данные = Новый Структура;
	Данные.Вставить("Ref", Строка(ЗаказПокупателяОбъект.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("DeletionMark", ЗаказПокупателяОбъект.ПометкаУдаления);
	Данные.Вставить("Date", ЗаказПокупателяОбъект.Дата);
	Данные.Вставить("Number", ЗаказПокупателяОбъект.Номер);
	Данные.Вставить("Posted", ЗаказПокупателяОбъект.Проведен);
	
	// Ссылочные поля - выводим наименование
	Данные.Вставить("Организация", Строка(ЗаказПокупателяОбъект.Организация));
	Данные.Вставить("Контрагент", Строка(ЗаказПокупателяОбъект.Контрагент));
	Данные.Вставить("Договор", Строка(ЗаказПокупателяОбъект.Договор));
	Данные.Вставить("Ответственный", Строка(ЗаказПокупателяОбъект.Ответственный));
	Данные.Вставить("ДК_КонтактноеЛицо", Строка(ЗаказПокупателяОбъект.ДК_КонтактноеЛицо));
	
	Данные.Вставить("СуммаДокумента", ЗаказПокупателяОбъект.СуммаДокумента);
	Данные.Вставить("Комментарий", ЗаказПокупателяОбъект.Комментарий);
	Данные.Вставить("ДК_СогласованнаяСкидка", ЗаказПокупателяОбъект.ДК_СогласованнаяСкидка);
	
	// Табличная часть Товары
	Товары = Новый Массив;
	Для Каждого СтрокаТовары Из ЗаказПокупателяОбъект.Товары Цикл
		СтрокаДанных = Новый Структура;
		СтрокаДанных.Вставить("Номенклатура", Строка(СтрокаТовары.Номенклатура));
		СтрокаДанных.Вставить("Количество", СтрокаТовары.Количество);
		СтрокаДанных.Вставить("Цена", СтрокаТовары.Цена);
		СтрокаДанных.Вставить("Скидка", СтрокаТовары.Скидка);
		СтрокаДанных.Вставить("Сумма", СтрокаТовары.Сумма);
		Товары.Добавить(СтрокаДанных);
	КонецЦикла;
	Данные.Вставить("Товары", Товары);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("json");
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл(ИмяВременногоФайла, , , Новый ПараметрыЗаписиJSON(, Символы.Таб));
	
	ЗаписатьJSON(ЗаписьJSON, Данные);
	ЗаписьJSON.Закрыть();
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);
	
	УдалитьФайлы(ИмяВременногоФайла);
	
	Возврат Адрес;
КонецФункции

&НаСервереБезКонтекста
Функция ОчиститьИмяФайла(ЗаказПокупателяСсылка)
	
	Имя = ЗаказПокупателяСсылка.ПолучитьОбъект();
	Имя = СокрЛП(Имя);
	
	Если Имя = Неопределено Тогда
		ВызватьИсключение "Заказ покупателя не найден.";
	КонецЕсли;
	
	НедопустимыеСимволы = "\/:*?""<>|";
	Для Сч = 1 По СтрДлина(НедопустимыеСимволы) Цикл
		Символ = Сред(НедопустимыеСимволы, Сч, 1);
		Имя = СтрЗаменить(Имя, Символ, "_");
	КонецЦикла;
	
	Если СтрДлина(Имя) > 100 Тогда
		Имя = Лев(Имя, 100);
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Длина имени сокращена до 100 символов.";
		СообщениеПользователю.Сообщить();
	КонецЕсли;
	
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Заказ покупателя";
	КонецЕсли;
	
	Возврат Имя;
	
КонецФункции

#КонецОбласти

#Область ЗаписатьЗаказПокупатедляИзJSON

&НаКлиенте
Асинх Процедура ПрочитатьФайлJSON(Команда)
	
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите JSON-файл с документом ЗаказПокупателя";
	ПараметрыДиалога.Фильтр = "Файлы JSON (*.json)|*.json";
	ПараметрыДиалога.МножественныйВыбор = Ложь;
	
	Результат = Ждать ПоместитьФайлНаСерверАсинх(,,, ПараметрыДиалога, УникальныйИдентификатор);
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АдресВоВременномХранилище = Результат.Адрес;
	
	СсылкаНаДокумент = ПрочитатьJSONНаСервере(АдресВоВременномХранилище);
	
	ПолноеИмя = Результат.СсылкаНаФайл.Файл.ПолноеИмя;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон("Файл (%1) успешно прочитан. Создан документ: %2", ПолноеИмя, СсылкаНаДокумент);
	Сообщение.Сообщить();	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьJSONНаСервере(АдресВоВременномХранилище)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("json");
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	ЧтениеТекста = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекста.UTF8);
	СтрокаJSON = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	
	ДанныеJSON = ПрочитатьJSON(Чтение);
	
	Чтение.Закрыть();
	УдалитьФайлы(ВременныйФайл);
	
	МассивСозданныхДокументов = Новый Массив;
	
	// Проверяем, есть ли массив Заказы
	Попытка
		МассивЗаказов = ДанныеJSON["Заказы"];
	Исключение
		// Если нет массива Заказы, значит это старый формат с одним заказом
		// Оборачиваем в массив
		МассивЗаказов = Новый Массив;
		МассивЗаказов.Добавить(ДанныеJSON);
	КонецПопытки;
	
	// Обрабатываем каждый заказ
	Для Каждого Данные Из МассивЗаказов Цикл
		
		// Создаем новый документ
		ДокументОбъект = Документы.ЗаказПокупателя.СоздатьДокумент();
		
		// Присваиваем текущую дату
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
		
		// ПометкаУдаления
		Попытка
			ДокументОбъект.ПометкаУдаления = Данные["DeletionMark"];
		Исключение
			ДокументОбъект.ПометкаУдаления = Ложь;
		КонецПопытки;
		
		// Находим ссылочные объекты по наименованию
		ДокументОбъект.Организация = НайтиОрганизацию(Данные["Организация"]);
		ДокументОбъект.Контрагент = НайтиКонтрагента(Данные["Контрагент"]);
		ДокументОбъект.Договор = НайтиДоговор(Данные["Договор"], ДокументОбъект.Контрагент);
		
		// Ответственный
		Попытка
			ОтветственныйИзJSON = Данные["Ответственный"];
			Если НЕ ПустаяСтрока(ОтветственныйИзJSON) Тогда
				ДокументОбъект.Ответственный = НайтиПользователя(ОтветственныйИзJSON);
			Иначе
				ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
			КонецЕсли;
		Исключение
			ДокументОбъект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецПопытки;
		
		// Контактное лицо
		Попытка
			КонтактноеЛицоИзJSON = Данные["ДК_КонтактноеЛицо"];
			Если НЕ ПустаяСтрока(КонтактноеЛицоИзJSON) Тогда
				КонтактноеЛицо = НайтиКонтактноеЛицо(КонтактноеЛицоИзJSON, ДокументОбъект.Контрагент);
				Если КонтактноеЛицо <> Неопределено Тогда
					ДокументОбъект.ДК_КонтактноеЛицо = КонтактноеЛицо;
				КонецЕсли;
			КонецЕсли;
		Исключение
			// Игнорируем ошибку
		КонецПопытки;
		
		// СуммаДокумента
		Попытка
			ДокументОбъект.СуммаДокумента = Данные["СуммаДокумента"];
		Исключение
			// Рассчитается автоматически
		КонецПопытки;
		
		// Комментарий
		Попытка
			ДокументОбъект.Комментарий = Данные["Комментарий"];
		Исключение
			ДокументОбъект.Комментарий = "";
		КонецПопытки;
		
		// ДК_СогласованнаяСкидка
		Попытка
			ДокументОбъект.ДК_СогласованнаяСкидка = Данные["ДК_СогласованнаяСкидка"];
		Исключение
			// Игнорируем ошибку
		КонецПопытки;
		
		// Заполняем табличную часть Товары
		ДокументОбъект.Товары.Очистить();
		
		МассивТоваров = Данные["Товары"];
		Для Каждого СтрокаТовара Из МассивТоваров Цикл
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			НоваяСтрока.Номенклатура = НайтиНоменклатуру(СтрокаТовара["Номенклатура"]);
			НоваяСтрока.Количество = СтрокаТовара["Количество"];
			НоваяСтрока.Цена = СтрокаТовара["Цена"];
			
			Попытка
				НоваяСтрока.Скидка = СтрокаТовара["Скидка"];
			Исключение
				НоваяСтрока.Скидка = 0;
			КонецПопытки;
			
			НоваяСтрока.Сумма = СтрокаТовара["Сумма"];
		КонецЦикла;
		
		// Определяем нужно ли проводить документ
		// По умолчанию проводим все документы
		ПроводитьДокумент = Истина;
		
		// Проверяем, есть ли явное указание не проводить
		Попытка
			Если Данные.Свойство("Posted") Тогда
				ПроводитьДокумент = Данные["Posted"];
			КонецЕсли;
		Исключение
			// По умолчанию проводим
			ПроводитьДокумент = Истина;
		КонецПопытки;
		
		// Записываем документ с проведением или без
		Попытка
			Если ПроводитьДокумент Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Иначе
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			// Если не удалось провести, пробуем просто записать
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			// Выводим предупреждение о том, что документ не был проведен
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Документ создан, но не проведен. Ошибка: %1", ОписаниеОшибки());
			Сообщение.Сообщить();
		КонецПопытки;
		
		МассивСозданныхДокументов.Добавить(ДокументОбъект.Ссылка);
		
	КонецЦикла;
	
	УдалитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	// Возвращаем список созданных документов
	Если МассивСозданныхДокументов.Количество() = 1 Тогда
		Возврат МассивСозданныхДокументов[0];
	Иначе
		Возврат СтрСоединить(МассивСозданныхДокументов, ", ");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиОрганизацию(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование = &Наименование
	|	И НЕ Организации.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		// Создаем новую организацию
		НоваяОрганизация = Справочники.Организации.СоздатьЭлемент();
		НоваяОрганизация.Наименование = Наименование;
		
		Попытка
			НоваяОрганизация.Записать();
			Возврат НоваяОрганизация.Ссылка;
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось создать организацию ""%1"": %2", Наименование, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиКонтрагента(Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Наименование = &Наименование
	|	И НЕ Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		// Создаем нового контрагента
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование = Наименование;
		
		Попытка
			НовыйКонтрагент.Записать();
			Возврат НовыйКонтрагент.Ссылка;
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось создать контрагента ""%1"": %2", Наименование, ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
	
КонецФункции

&НаСервереБезКонтекста
Функция НайтиДоговор(Наименование, Контрагент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Наименование = &Наименование
	|	И ДоговорыКонтрагентов.Владелец = &Контрагент
	|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		// Создаем новый договор
		НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		НовыйДоговор.Наименование = Наименование;
		НовыйДоговор.Владелец = Контрагент;
		
		Попытка
			НовыйДоговор.Записать();
			Возврат НовыйДоговор.Ссылка;
		Исключение
			ВызватьИсключение СтрШаблон("Не удалось создать договор ""%1"" для контрагента ""%2"": %3", Наименование, Контрагент, ОписаниеОшибки());
		КонецПопытки;
